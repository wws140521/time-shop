{
  "package_version": 2,
  "version": "1.0.0",
  "name": "time-shop-builder",
  "title": "TimeShop 场景生成器",
  "description": "一键为《拾光小卖部》生成主场景：HUD、各面板模板与全部组件/事件绑定。",
